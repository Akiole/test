# ============================================================
# Host OS detection + cross-platform GNU tool selection
# Included by all Makefiles in the project to eliminate duplicate definitions
#
# macOS uses GNU tools installed via Homebrew (gsed/gtar/gpatch/gxargs)
# Linux uses system-provided tools
#
# Usage: include this file at the top of your Makefile
#   include $(SOURCE_DIR)/host-tools.mk   # top-level Makefile
#   include host-tools.mk                  # trunk/Makefile (CURDIR=trunk)
#   include $(ROOTDIR)/host-tools.mk       # subdirectory Makefile
#   include $(dir $(lastword $(MAKEFILE_LIST)))host-tools.mk  # rules.mk
# ============================================================

# OS detection (?= allows inheritance from environment/parent Makefile, avoiding repeated $(shell uname))
HOST_OS  ?= $(shell uname)
IS_DARWIN ?= $(filter Darwin,$(HOST_OS))
HOST_OS_LOWER ?= $(shell echo $(HOST_OS) | tr '[:upper:]' '[:lower:]')
HOST_ARCH     ?= $(shell uname -m)

# Host environment (CPU cores, parallel jobs, shell path)
HOST_NCPU    ?= $(shell nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 1)
JOBS         ?= -j$(HOST_NCPU)
CONFIG_SHELL ?= $(shell command -v bash 2>/dev/null || echo /bin/sh)
export HOST_OS IS_DARWIN HOST_OS_LOWER HOST_ARCH HOST_NCPU JOBS CONFIG_SHELL

# Cross-platform GNU tools
# SED includes -i -e (in-place edit); SED_READ is read-only version (no -i)
# Note: SED is not exported to subprocess environment to prevent -i from breaking text filtering in tools like autoreconf/configure
SED       := $(if $(IS_DARWIN),gsed,sed) -i -e
SED_READ  := $(if $(IS_DARWIN),gsed,sed)
unexport SED
TAR       ?= $(if $(IS_DARWIN),gtar,tar)
XARGS     := $(if $(IS_DARWIN),gxargs -r,xargs -r)
PATCH     := $(if $(IS_DARWIN),gpatch,patch)
FIND      := find
# macOS ships make 3.81 which is too old; complex recursive Makefiles generated by automake require GNU Make 4.x
# Only overrides recursive $(MAKE) calls; top-level make is still determined by user command line
MAKE      := $(if $(IS_DARWIN),gmake,$(MAKE))

# File operations
CP        := cp -fpR
LN        := ln -sf

# Install commands
INSTALL_BIN  := install -m0755
INSTALL_SUID := install -m4755
INSTALL_DIR  := install -d -m0755
INSTALL_DATA := install -m0644
INSTALL_CONF := install -m0600
