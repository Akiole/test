# ============================================================
# Host OS detection + cross-platform GNU tool selection
# Included by all Makefiles in the project to eliminate duplicate definitions
#
# macOS uses GNU tools installed via Homebrew (gsed/gtar/gpatch/gxargs)
# Linux uses system-provided tools
#
# Usage: include this file at the top of your Makefile
#   include $(SOURCE_DIR)/host-tools.mk   # top-level Makefile
#   include host-tools.mk                  # trunk/Makefile (CURDIR=trunk)
#   include $(ROOTDIR)/host-tools.mk       # subdirectory Makefile
#   include $(dir $(lastword $(MAKEFILE_LIST)))host-tools.mk  # rules.mk
# ============================================================

# OS detection (?= allows inheritance from environment/parent Makefile, avoiding repeated $(shell uname))
HOST_OS  ?= $(shell uname)
IS_DARWIN ?= $(filter Darwin,$(HOST_OS))
HOST_OS_LOWER ?= $(shell echo $(HOST_OS) | tr '[:upper:]' '[:lower:]')
HOST_ARCH     ?= $(shell uname -m)

# Host environment (CPU cores, parallel jobs, shell path)
HOST_NCPU    ?= $(shell nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 1)
JOBS         ?= -j$(HOST_NCPU)
CONFIG_SHELL ?= $(shell command -v bash 2>/dev/null || echo /bin/sh)
export HOST_OS IS_DARWIN HOST_OS_LOWER HOST_ARCH HOST_NCPU JOBS CONFIG_SHELL

# === macOS Homebrew detection ===
# Single source of truth for Homebrew prefix and GNU tool paths.
# CI workflows and toolchain/Makefile should reuse DARWIN_GNU_PATH instead
# of maintaining their own duplicate PATH lists.
ifeq ($(IS_DARWIN),Darwin)
HOMEBREW_PREFIX ?= $(shell brew --prefix 2>/dev/null || echo /opt/homebrew)

# Colon-separated list of GNU tool directories (gnubin provides unprefixed names).
# $(strip) collapses tabs/newlines to single spaces, then $(subst) removes them so
# the result is a clean colon-separated PATH with no embedded whitespace.
empty :=
space := $(empty) $(empty)
DARWIN_GNU_PATH := $(subst $(space),,$(strip \
	$(HOMEBREW_PREFIX)/opt/coreutils/libexec/gnubin:\
	$(HOMEBREW_PREFIX)/opt/grep/libexec/gnubin:\
	$(HOMEBREW_PREFIX)/opt/findutils/libexec/gnubin:\
	$(HOMEBREW_PREFIX)/opt/gnu-sed/libexec/gnubin:\
	$(HOMEBREW_PREFIX)/opt/gnu-tar/libexec/gnubin:\
	$(HOMEBREW_PREFIX)/opt/gpatch/libexec/gnubin:\
	$(HOMEBREW_PREFIX)/opt/make/libexec/gnubin:\
	$(HOMEBREW_PREFIX)/opt/diffutils/bin:\
	$(HOMEBREW_PREFIX)/opt/m4/bin:\
	$(HOMEBREW_PREFIX)/opt/flex/bin:\
	$(HOMEBREW_PREFIX)/opt/bison/bin:\
	$(HOMEBREW_PREFIX)/opt/gawk/libexec/gnubin:\
	$(HOMEBREW_PREFIX)/opt/gettext/bin))
export DARWIN_GNU_PATH
endif

# === Cross-platform GNU tools ===
# SED includes -i -e (in-place edit); SED_READ is read-only version (no -i)
# Note: SED is not exported to subprocess environment to prevent -i from breaking text filtering in tools like autoreconf/configure
ifeq ($(IS_DARWIN),Darwin)
SED       := $(HOMEBREW_PREFIX)/opt/gnu-sed/libexec/gnubin/sed -i -e
SED_READ  := $(HOMEBREW_PREFIX)/opt/gnu-sed/libexec/gnubin/sed
TAR       := $(HOMEBREW_PREFIX)/opt/gnu-tar/libexec/gnubin/tar
PATCH     := $(HOMEBREW_PREFIX)/opt/gpatch/libexec/gnubin/patch
AWK       := $(HOMEBREW_PREFIX)/opt/gawk/libexec/gnubin/awk
GREP      := $(HOMEBREW_PREFIX)/opt/grep/libexec/gnubin/grep
REALPATH  := $(HOMEBREW_PREFIX)/opt/coreutils/libexec/gnubin/realpath
READLINK  := $(HOMEBREW_PREFIX)/opt/coreutils/libexec/gnubin/readlink
else
SED       := sed -i -e
SED_READ  := sed
TAR       ?= tar
PATCH     := patch
AWK       := awk
GREP      := grep
REALPATH  := realpath
READLINK  := readlink
endif
unexport SED

XARGS     := $(if $(IS_DARWIN),gxargs -r,xargs -r)
FIND      := find
# macOS ships make 3.81 which is too old; complex recursive Makefiles generated by automake require GNU Make 4.x
# Only overrides recursive $(MAKE) calls; top-level make is still determined by user command line
MAKE      := $(if $(IS_DARWIN),gmake,$(MAKE))

# File operations
CP        := cp -fpR
LN        := ln -sf

# Install commands
INSTALL_BIN  := install -m0755
INSTALL_SUID := install -m4755
INSTALL_DIR  := install -d -m0755
INSTALL_DATA := install -m0644
INSTALL_CONF := install -m0600

# === Helper targets ===
# NOTE: avoid defining any real build target here. This file is included by
# every sub-Makefile (trunk, tools, libs, user, vendors, ...), so any target
# defined here would appear before their own 'all' and become GNU make's
# default goal, silently short-circuiting the build. DARWIN_GNU_PATH is
# already exported above for any consumer that needs it.

# === Shared toolchain verification shell function ===
# Parameterized: call verify_tc <prefix> <triplet> in recipes after expansion.
# Checks: gcc runs, key binaries exist, sysroot headers + crt1.o present.
# Used by top-level Makefile and toolchain/Makefile (single source of truth).
define VERIFY_TOOLCHAIN_FUNC
verify_tc() { \
	local tc_prefix="$$1" tc_triplet="$$2"; \
	[ -x "$$tc_prefix/bin/$$tc_triplet-gcc" ] && "$$tc_prefix/bin/$$tc_triplet-gcc" --version >/dev/null 2>&1 || return 1; \
	for t in ld as ar ranlib strip objcopy; do \
		[ -x "$$tc_prefix/bin/$$tc_triplet-$$t" ] || return 1; \
	done; \
	[ -f "$$tc_prefix/$$tc_triplet/sysroot/usr/include/stdio.h" ] || return 1; \
	[ -f "$$tc_prefix/$$tc_triplet/sysroot/usr/lib/crt1.o" ] || return 1; \
};
endef
