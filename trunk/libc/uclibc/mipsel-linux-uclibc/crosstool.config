CT_CONFIG_VERSION="4"

# ============================================================================
# Build behavior
# ============================================================================
CT_EXPERIMENTAL=y

# Allow building as root (inside containers / CI)
CT_ALLOW_BUILD_AS_ROOT=y
CT_ALLOW_BUILD_AS_ROOT_SURE=y

# Install into toolchain/mipsel-linux-uclibc/
CT_PREFIX_DIR="${CT_TOP_DIR}/../${CT_TARGET}"
# Keep install dir writable (Padavan build creates ccache-wrappers/ symlinks here)
CT_PREFIX_DIR_RO=n

# Strip target binaries (gdbserver etc.); host stripping handled by finish step
CT_STRIP_TARGET_TOOLCHAIN_EXECUTABLES=y

# ============================================================================
# Paths & downloads
# ============================================================================
# Tarball cache survives `make clean`; shared across rebuilds
# CT_LOCAL_TARBALLS_DIR="${CT_TOP_DIR}/../tarballs"
CT_DOWNLOAD_AGENT_CURL=y

# ============================================================================
# Logging
# ============================================================================
# Persist build.log into the toolchain output dir for post-mortem debugging
# (CT_LOG_TO_FILE defaults to y)

# Disable the spinner/progress-bar in non-interactive environments (CI,
# scripts, `make` pipelines).  It emits thousands of "[00:00] /" rotation
# lines when stdout is not a TTY, drowning real log output.
CT_LOG_PROGRESS_BAR=n

# ============================================================================
# Target architecture: MIPS32R2 little-endian (MediaTek MT7621)
# ============================================================================
CT_ARCH_MIPS=y
CT_ARCH_LE=y
CT_ARCH_TUNE="mips32r2"
CT_ARCH_ARCH="mips32r2"
CT_OMIT_TARGET_VENDOR=y

# Soft-float (MT7621 has no FPU)
# CT_ARCH_FLOAT_AUTO is NOT set — auto-detect defaults to hard-float on mips32r2
CT_ARCH_FLOAT_SW=y
CT_ARCH_FLOAT="soft"

# -ffunction-sections/-fdata-sections shrink binaries with --gc-sections;
# -fcommon removed (GCC 10+ defaults to -fno-common)
CT_TARGET_CFLAGS="-pipe -Os -mips32r2 -msoft-float -ffunction-sections -fdata-sections"

# ============================================================================
# Kernel headers: custom 4.4.x from Padavan trunk
# ============================================================================
CT_KERNEL_LINUX=y
CT_LINUX_SRC_CUSTOM=y
CT_LINUX_CUSTOM_LOCATION="${CT_TOP_DIR}/../../trunk/linux-4.4.x"
CT_LINUX_V_4_4=y

# ============================================================================
# C library: uClibc-ng 1.0.x
# ============================================================================
CT_LIBC_UCLIBC_NG=y
CT_UCLIBC_NG_SRC_RELEASE=y
CT_UCLIBC_NG_V_1_0_54=y

# Custom uClibc config (defconfig tweaks for embedded router)
# Points directly to the source file in trunk/libc/uclibc/ (no copy needed)
CT_LIBC_UCLIBC_CONFIG_FILE="${CT_TOP_DIR}/../../trunk/libc/uclibc/uclibc.config"

# IPv6 required for modern networking; locale/wchar disabled to keep
# the libc small on 128 MB RAM devices.
#
# WCHAR / wide-character support:
#   - crosstool-ng:  CT_LIBC_UCLIBC_WCHAR (enabled)
#   - uclibc.config: UCLIBC_HAS_WCHAR      (enabled)
#   Both must be enabled together; crosstool-ng passes CT_LIBC_UCLIBC_WCHAR
#   into the uClibc .config as UCLIBC_HAS_WCHAR.
#   Impact: adds ~30 KB to libc; required for ncurses --enable-widec
#   (libncursesw) and htop --enable-unicode.
CT_LIBC_UCLIBC_WCHAR=y
CT_LIBC_UCLIBC_IPV6=y

# SSP: use uClibc's built-in stack protector (libssp=m lets libc provide it)
CT_LIBC_UCLIBC_HAS_SSP=y
CT_CC_GCC_LIBSSP=m

# ============================================================================
# Compiler: GCC 13.x
# ============================================================================
CT_GCC_V_13=y

# --with-system-zlib is required on macOS: the zlib bundled with
# binutils/gcc/gdb fails against recent Apple SDKs (zutil.h redefines
# fdopen and breaks stdio.h).
# --with-sysroot / --with-local-prefix use ${CT_PREFIX_DIR}/... (keeping
# the '..') so they match --prefix.  crosstool-ng's own args use the
# sanitised CT_SYSROOT_DIR (no '..'), which breaks GCC's
# TARGET_SYSTEM_ROOT_RELOCATABLE detection — overriding here makes the
# whole toolchain relocatable.
CT_BINUTILS_EXTRA_CONFIG_ARRAY="--with-system-zlib --with-sysroot=${CT_PREFIX_DIR}/${CT_TARGET}/sysroot"
CT_CC_GCC_CORE_EXTRA_CONFIG_ARRAY="--with-gnu-ld --disable-libsanitizer --disable-libquadmath --with-system-zlib --with-sysroot=${CT_PREFIX_DIR}/${CT_TARGET}/sysroot --with-local-prefix=${CT_PREFIX_DIR}/${CT_TARGET}/sysroot"
CT_CC_GCC_EXTRA_CONFIG_ARRAY="--with-gnu-ld --disable-libsanitizer --disable-libquadmath --disable-libitm --with-system-zlib --with-sysroot=${CT_PREFIX_DIR}/${CT_TARGET}/sysroot --with-local-prefix=${CT_PREFIX_DIR}/${CT_TARGET}/sysroot"

CT_CC_GCC_CONFIG_TLS=y

# Optimise GCC's target libs (libgcc, libstdc++) for size
CT_CC_GCC_ENABLE_TARGET_OPTSPACE=y

# LTO needs binutils plugin support. CT_CC_GCC_ENABLE_PLUGINS is a hidden
# def_bool that is y only when BINUTILS_PLUGINS=y; without it GCC is built
# --disable-plugin, ld.bfd is built --disable-plugins, the lib/bfd-plugins
# directory is not created, and the liblto_plugin symlink is never installed
# — so -flto / -fno-fat-lto-objects / -fuse-linker-plugin all fail.
# (CT_CC_GCC_USE_LTO defaults to y)
CT_BINUTILS_PLUGINS=y
CT_CC_LANG_CXX=y

# Host compiler flags: -pipe speeds up the build, -fomit-frame-pointer
# frees a register on the host (x86_64/aarch64)
CT_EXTRA_CFLAGS_FOR_HOST="-O2 -pipe -fomit-frame-pointer"

# ============================================================================
# Debug facilities
# ============================================================================
# Cross GDB: runs on host, debugs target programs via gdbserver over network/serial
CT_DEBUG_GDB=y
CT_GDB_CROSS=y
# Disable Python scripting: GDB 17.x + Python on macOS GCC-13 hits
# "invalid r_symbolnum" linker errors (Mach-O relocation symbol index > 255)
CT_GDB_CROSS_PYTHON=n
# gdbserver: runs on target router, paired with host cross-gdb for remote debugging
CT_GDB_GDBSERVER=y
