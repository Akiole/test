CT_CONFIG_VERSION="4"

# ============================================================================
# Build behavior
# ============================================================================
CT_EXPERIMENTAL=y

# Allow root build (containers / CI)
CT_ALLOW_BUILD_AS_ROOT=y
CT_ALLOW_BUILD_AS_ROOT_SURE=y

# Install to toolchain/<target>/; keep writable (ccache symlinks)
CT_PREFIX_DIR="${CT_TOP_DIR}/../${CT_TARGET}"
# CT_INSTALL_LICENSES is not set
# CT_PREFIX_DIR_RO is not set

# Strip target binaries; host stripping handled by finish step
CT_STRIP_TARGET_TOOLCHAIN_EXECUTABLES=y

# ============================================================================
# Paths & downloads
# ============================================================================
# Tarball cache survives make clean; shared across rebuilds
# CT_LOCAL_TARBALLS_DIR="${CT_TOP_DIR}/../tarballs"
CT_DOWNLOAD_AGENT_CURL=y

# ============================================================================
# Logging
# ============================================================================
# Persist build.log (CT_LOG_TO_FILE defaults to y)
# Disable progress bar in CI/non-TTY (thousands of rotation lines drown output)
# CT_LOG_PROGRESS_BAR is not set
# CT_LOG_TO_FILE is not set

# ============================================================================
# Target: MIPS32R2 little-endian (MediaTek MT7621)
# ============================================================================
CT_ARCH_MIPS=y
CT_ARCH_LE=y
CT_ARCH_TUNE="mips32r2"
CT_ARCH_ARCH="mips32r2"
CT_OMIT_TARGET_VENDOR=y

# Soft-float (MT7621 has no FPU; auto-detect would default to hard-float)
CT_ARCH_FLOAT_SW=y
CT_ARCH_FLOAT="soft"

# -ffunction-sections/-fdata-sections + --gc-sections shrink binaries
CT_TARGET_CFLAGS="-pipe -Os -mips32r2 -msoft-float -ffunction-sections -fdata-sections"

# ============================================================================
# Kernel headers: custom 4.4.x from Padavan trunk
# ============================================================================
CT_KERNEL_LINUX=y
CT_LINUX_SRC_CUSTOM=y
CT_LINUX_CUSTOM_LOCATION="${CT_TOP_DIR}/../../trunk/linux-4.4.x"
CT_LINUX_V_4_4=y

# ============================================================================
# C library: uClibc-ng 1.0.x
# ============================================================================
CT_LIBC_UCLIBC_NG=y
CT_UCLIBC_NG_SRC_RELEASE=y
CT_UCLIBC_NG_V_1_0_54=y

# Custom uClibc config (defconfig tweaks for embedded router)
CT_LIBC_UCLIBC_CONFIG_FILE="${CT_TOP_DIR}/../../trunk/libc/uclibc/uclibc.config"

# IPv6 required for modern networking; WCHAR adds ~30 KB but needed for
# ncursesw/htop — must match UCLIBC_HAS_WCHAR in uclibc.config
CT_LIBC_UCLIBC_WCHAR=y
CT_LIBC_UCLIBC_IPV6=y

# uClibc has built-in SSP; libssp=m lets libc provide it
CT_LIBC_UCLIBC_HAS_SSP=y
CT_CC_GCC_LIBSSP=m

# ============================================================================
# Compiler: GCC 14.x
# ============================================================================
CT_GCC_V_14=y

# --with-system-zlib: bundled zlib breaks on macOS (zutil.h redefines fdopen)
# --with-sysroot/--with-local-prefix keep '..' to match --prefix, making the
#   toolchain relocatable (crosstool-ng's sanitised path breaks detection)
# --disable-*: drop unused target libs (sanitizer/quadmath/itm/gomp/vtv/
#   decimal-float/fixed-point) and host NLS message catalogs
CT_BINUTILS_EXTRA_CONFIG_ARRAY="--with-system-zlib --disable-nls --with-sysroot=${CT_PREFIX_DIR}/${CT_TARGET}/sysroot"
CT_CC_GCC_CORE_EXTRA_CONFIG_ARRAY="--with-gnu-ld --disable-libsanitizer --disable-libquadmath --disable-nls --with-system-zlib --with-sysroot=${CT_PREFIX_DIR}/${CT_TARGET}/sysroot --with-local-prefix=${CT_PREFIX_DIR}/${CT_TARGET}/sysroot"
CT_CC_GCC_EXTRA_CONFIG_ARRAY="--with-gnu-ld --disable-libsanitizer --disable-libquadmath --disable-libitm --disable-libgomp --disable-libvtv --disable-decimal-float --disable-fixed-point --disable-nls --with-system-zlib --with-sysroot=${CT_PREFIX_DIR}/${CT_TARGET}/sysroot --with-local-prefix=${CT_PREFIX_DIR}/${CT_TARGET}/sysroot"

CT_CC_GCC_CONFIG_TLS=y

# GRAPHITE loop optimiser disabled (HPC-only, needs ISL, no benefit at -Os)
# CT_CC_GCC_USE_GRAPHITE is not set

# Build libgcc/libstdc++ with -Os
CT_CC_GCC_ENABLE_TARGET_OPTSPACE=y

# LTO needs binutils plugins: without BINUTILS_PLUGINS=y, GCC is built
# --disable-plugin, liblto_plugin is never installed, and -flto fails
CT_BINUTILS_PLUGINS=y
CT_CC_LANG_CXX=y

# Host flags: -pipe speeds build, -fomit-frame-pointer frees a register
CT_EXTRA_CFLAGS_FOR_HOST="-O2 -pipe -fomit-frame-pointer"

# ============================================================================
# Debug facilities (disabled for production toolchain)
# ============================================================================
# CT_DEBUG_GDB=y
# CT_GDB_CROSS=y

# GDB 17 + Python on macOS hits Mach-O r_symbolnum errors
# CT_GDB_CROSS_PYTHON=n
# CT_GDB_GDBSERVER=n
