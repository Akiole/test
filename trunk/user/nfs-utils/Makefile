include $(ROOTDIR)/rules.mk

PKG_NAME:=nfs-utils
PKG_VERSION:=3.1.1
PKG_SOURCE:=$(PKG_NAME)-$(PKG_VERSION).tar.xz
PKG_SOURCE_URL:=https://www.kernel.org/pub/linux/utils/nfs-utils/$(PKG_VERSION)/
PKG_HASH:=7dbc05eb8b32828b322872b759a62cb3979cb4118f344dd8616813d1390e84e0

include $(INCLUDE_DIR)/package.mk

TARGET_CFLAGS += -fvisibility=hidden -Drpc_uint=uint32_t -Wno-error -Wno-error=missing-prototypes -Wno-error=strict-prototypes -Wno-error=missing-declarations

# replace nfs-utils' aggressive -Werror=* AM_CFLAGS set (tirpc's newer
# xdrproc_t prototypes trip them on rpcgen-generated code).  GCC 14
# -Wno-incompatible-pointer-types is supplied globally via rules.mk.

MAKE_FLAGS += AM_CFLAGS="-Drpc_uint=uint32_t -Wno-error"

CONFIGURE_VARS += \
	knfsd_cv_bsd_signals=no \
	ac_cv_func_getrpcbynumber=yes \
	ac_cv_func_getrpcbynumber_r=yes \
	lt_cv_deplibs_check_method=pass_all \
	PKG_CONFIG=/opt/homebrew/bin/pkg-config \
	PKG_CONFIG_PATH=$(STAGING_DIR)/lib/pkgconfig \
	PKG_CONFIG_SYSROOT_DIR=$(STAGING_DIR)

CONFIGURE_ARGS += \
	--prefix=/ \
	--disable-ipv6 \
	--disable-mount \
	--disable-mountconfig \
	--disable-nfsv4 \
	--disable-uuid \
	--disable-gss \
	--disable-nfsrahead \
	--disable-nfsdctl \
	--enable-tirpc

# nfs-utils 3.x ships pre-generated configure in the tarball.
# autogen.sh requires libtoolize which may not be available on the host.
# Skip autogen.sh and use the shipped configure directly.

# nfs-utils' pre-generated libtool script mishandles cross-compile .la
# resolution (looks for /lib/libnl-3.la instead of staging path).
# Remove .la files from staging so libtool falls back to direct .so linking.

define nfs_remove_la_files
	rm -f $(STAGING_DIR)/lib/*.la
endef

Hooks/Configure/Pre += nfs_remove_la_files

# sm_inter_svc.c is generated by rpcgen at build time and includes
# sys/ttycom.h which is BSD-only and absent on Linux. Create a stub
# header so compilation succeeds without modifying the generated file.
define Build/Prepare
	$(call Build/Prepare/Default)
	mkdir -p $(PKG_BUILD_DIR)/compat-include/sys
	touch $(PKG_BUILD_DIR)/compat-include/sys/ttycom.h
endef

TARGET_CFLAGS += -I$(PKG_BUILD_DIR)/compat-include

define Build/Configure
	(cd $(PKG_BUILD_DIR); \
		$(CONFIGURE_VARS) \
		./configure \
			$(CONFIGURE_ARGS); \
	)
endef

$(eval $(call BuildPackage,$(PKG_NAME)))

romfs:
	$(ROMFSINST) -p +x /usr/bin/nfsd.sh
	$(ROMFSINST) $(PKG_BUILD_DIR)/utils/exportfs/exportfs /sbin/exportfs
	$(ROMFSINST) $(PKG_BUILD_DIR)/utils/nfsd/nfsd /sbin/rpc.nfsd
	$(ROMFSINST) $(PKG_BUILD_DIR)/utils/mountd/mountd /sbin/rpc.mountd
