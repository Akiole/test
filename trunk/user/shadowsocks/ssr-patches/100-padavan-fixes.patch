-        } else if (s < (ssize_t)(remote->buf->len)) {
-            // partly sent, move memory, wait for the next time to send
-            remote->buf->len -= s;
-            remote->buf->idx += s;
-            return;
-        } else {
-            // all sent out, wait for reading
-            remote->buf->len = 0;
-            remote->buf->idx = 0;
-            ev_io_remote_send(EV_A_ server, remote);
-        }
-    }
-}
