-    } else {
-        if (mode == IPTABLES_MODE)
-            sprintf(cli, ip.version == 4 ? iptables_remove_rule : ip6tables_remove_rule,
-                    chain_name, addr);
-        else if (mode == FIREWALLD_MODE)
-            sprintf(cli, ip.version == 4 ? firewalld_remove_rule : firewalld6_remove_rule,
