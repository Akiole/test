-static void
-parse_addr_cidr(const char *str, char *host, int *cidr)
-{
-    int ret = -1, n = 0;
-    char *pch;
-
-    pch = strchr(str, '/');
-    while (pch != NULL) {
-        n++;
-        ret = pch - str;
-        pch = strchr(pch + 1, '/');
-    }
-    if (ret == -1) {
-        strcpy(host, str);
-        *cidr = -1;
-    } else {
-        memcpy(host, str, ret);
-        host[ret] = '\0';
-        *cidr     = atoi(str + ret + 1);
-    }
-}
-
-char *
-trimwhitespace(char *str)
-{
-    char *end;
-
-    // Trim leading space
-    while (isspace(*str))
-        str++;
-
-    if (*str == 0)   // All spaces?
-        return str;
-
-    // Trim trailing space
-    end = str + strlen(str) - 1;
-    while (end > str && isspace(*end))
-        end--;
-
-    // Write new null terminator
-    *(end + 1) = 0;
-
-    return str;
-}
