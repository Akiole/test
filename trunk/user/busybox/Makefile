include $(ROOTDIR)/rules.mk

PKG_NAME:=busybox
PKG_VERSION:=1.38.0
PKG_SOURCE:=$(PKG_NAME)-$(PKG_VERSION).tar.bz2
PKG_SOURCE_URL:=https://www.busybox.net/downloads/
PKG_HASH:=34f9ea6ff8636f2c9241153b9114eefa9e65674a45318ae1ef95bb5f31c53bb2

include $(INCLUDE_DIR)/package.mk

# Busybox Kbuild composes _c_flags = $(CFLAGS) $(EXTRA_CFLAGS).  Passing
# EXTRA_CFLAGS via MAKE_FLAGS places it AFTER -Wall on the command line, so
# these -Wno-* take precedence.  Legacy-code triggers: telnetd unused var,
# pw_ascii64 unused function, syslogd const-qualifier, xshared always_inline.
MAKE_FLAGS += EXTRA_CFLAGS="-Wno-discarded-qualifiers -Wno-inline -Wno-unused-but-set-variable -Wno-unused-function"

# Copy busybox .config into build tree after unpack/patch.  Prefer the
# firmware-tweaked config generated by configure (busybox.config.generated);
# fall back to the base busybox.config for standalone package builds.
define Build/Prepare
	$(call Build/Prepare/Default)
	$(CP) $(firstword $(wildcard ./busybox.config.generated) ./busybox.config) $(PKG_BUILD_DIR)/.config
endef

$(eval $(call BuildPackage,$(PKG_NAME)))

romfs:
	$(MAKE) -C $(PKG_BUILD_DIR) $(MAKE_FLAGS) CONFIG_PREFIX=$(ROMFSDIR) install
