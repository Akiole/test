+ Description :
+ ============================================================================
+ */
+
+#include "asm.h"
+
+NESTED(hev_task_execute)
+    mov  %esp, %eax
+    mov  0x4(%esp), %edx
+    mov  0x8(%esp), %ecx
+    mov  (%edx), %esp
+    sub  $0x8, %esp
+    push %eax
+
+    push %edx
+    call  *%ecx
+
+    mov  0x4(%esp), %esp
+    ret
+END(hev_task_execute)
