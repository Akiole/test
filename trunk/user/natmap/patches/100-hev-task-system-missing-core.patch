+
+#ifndef __HEV_TASK_SYSTEM_PRIVATE_H__
+#define __HEV_TASK_SYSTEM_PRIVATE_H__
+
+#include <setjmp.h>
+
+#include "kern/task/hev-task.h"
+#include "kern/task/hev-task-private.h"
+#include "kern/io/hev-task-io-reactor.h"
+#include "kern/time/hev-task-timer.h"
+#include "lib/list/hev-list.h"
+#include "lib/rbtree/hev-rbtree-cached.h"
+
+typedef struct _HevTaskDNSProxy HevTaskDNSProxy;
+typedef struct _HevTaskStackDetector HevTaskStackDetector;
+typedef struct _HevTaskSystemContext HevTaskSystemContext;
+
+struct _HevTaskSystemContext
+{
+    HevList all_tasks;
+    HevRBTreeCached run_queue;
+    HevTask *current_task;
+    HevTaskIOReactor *reactor;
+    HevTaskTimer *timer;
+    HevTaskDNSProxy *dns_proxy;
+    HevTaskStackDetector *stack_detector;
+    jmp_buf main_context;
+    int total_task_count;
+    int running_task_count;
+    int running;
+};
+
+HevTaskSystemContext *hev_task_system_get_context (void);
+
+void hev_task_system_wakeup_task (HevTask *task);
+void hev_task_system_wakeup_task_with_context (HevTaskSystemContext *ctx,
+                                                 HevTask *task);
+void hev_task_system_schedule (HevTaskYieldType type);
+void hev_task_system_run_new_task (HevTask *task);
+void hev_task_system_kill_current_task (void);
+
+#endif /* __HEV_TASK_SYSTEM_PRIVATE_H__ */
diff -ruN a/third-part/hev-task-system/src/kern/core/hev-task-system.c b/third-part/hev-task-system/src/kern/core/hev-task-system.c
--- a/third-part/hev-task-system/src/kern/core/hev-task-system.c	1970-01-01 08:00:00.000000000 +0800
+++ b/third-part/hev-task-system/src/kern/core/hev-task-system.c	2026-08-24 14:33:47.803589355 +0800
@@ -0,0 +1,245 @@
+/*
+ ============================================================================
+ Name        : hev-task-system.c
+ Author      : Heiher <r@hev.cc>
+ Copyright   : Copyright (c) 2017 - 2025 everyone.
+ Description : Task System Core
+ ============================================================================
+ */
+
+#include <stdlib.h>
+#include <string.h>
+#include <setjmp.h>
+
+#include "hev-task-system.h"
+#include "hev-task-system-private.h"
+#include "kern/task/hev-task-private.h"
+#include "kern/task/hev-task-executer.h"
+#include "mem/api/hev-memory-allocator-api.h"
+#include "lib/misc/hev-compiler.h"
+#include "lib/dns/hev-task-dns-proxy.h"
+#include "lib/misc/hev-task-stack-detector.h"
+
+#define MAX_EVENTS 64
+
+static HevTaskSystemContext _ctx;
+
+HevTaskSystemContext *
+hev_task_system_get_context (void)
+{
+    return &_ctx;
+}
+
+static int
+task_node_cmp (HevTask *a, HevTask *b)
+{
+    if (a->sched_key < b->sched_key)
+        return -1;
+    if (a->sched_key > b->sched_key)
+        return 1;
+    if (a < b)
+        return -1;
+    if (a > b)
+        return 1;
+    return 0;
+}
+
+static void
+run_queue_insert (HevTaskSystemContext *ctx, HevTask *task)
+{
+    HevRBTreeNode **new = &ctx->run_queue.base.root, *parent = NULL;
+    int leftmost = 1;
+
+    while (*new) {
+        HevTask *this = container_of (*new, HevTask, sched_node);
+        int result = task_node_cmp (task, this);
+
+        parent = *new;
+        if (result < 0) {
+            new = &((*new)->left);
+        } else {
+            new = &((*new)->right);
+            leftmost = 0;
+        }
+    }
+    hev_rbtree_node_link (&task->sched_node, parent, new);
+    hev_rbtree_cached_insert_color (&ctx->run_queue, &task->sched_node,
+                                     leftmost);
+}
+
+static void
+run_queue_erase (HevTaskSystemContext *ctx, HevTask *task)
+{
+    hev_rbtree_cached_erase (&ctx->run_queue, &task->sched_node);
+}
+
+static HevTask *
+run_queue_first (HevTaskSystemContext *ctx)
+{
+    HevRBTreeNode *node = hev_rbtree_cached_first (&ctx->run_queue);
+    if (!node)
+        return NULL;
+    return container_of (node, HevTask, sched_node);
+}
+
+void
+hev_task_system_wakeup_task_with_context (HevTaskSystemContext *ctx,
+                                            HevTask *task)
+{
+    if (task->state == HEV_TASK_RUNNING)
+        return;
+
+    task->state = HEV_TASK_RUNNING;
+    task->sched_key = task->priority;
+    run_queue_insert (ctx, task);
+}
+
+void
+hev_task_system_wakeup_task (HevTask *task)
+{
+    hev_task_system_wakeup_task_with_context (&_ctx, task);
+}
+
+void
+hev_task_system_run_new_task (HevTask *task)
+{
+    task->state = HEV_TASK_RUNNING;
+    task->sched_key = task->priority;
+    run_queue_insert (&_ctx, task);
+    _ctx.running_task_count++;
+    _ctx.total_task_count++;
+}
+
+void
+hev_task_system_kill_current_task (void)
+{
+    HevTask *task = _ctx.current_task;
+
+    if (!task)
+        return;
+
+    if (task->state == HEV_TASK_RUNNING)
+        run_queue_erase (&_ctx, task);
+
+    task->state = HEV_TASK_STOPPED;
+    _ctx.running_task_count--;
+    _ctx.current_task = NULL;
+    _longjmp (_ctx.main_context, 1);
+}
+
+void
+hev_task_system_schedule (HevTaskYieldType type)
+{
+    HevTask *current = _ctx.current_task;
+    HevTask *next;
+
+    if (!current)
+        return;
+
+    run_queue_erase (&_ctx, current);
+
+    if (type == HEV_TASK_YIELD) {
+        current->state = HEV_TASK_RUNNING;
+        current->sched_key = current->priority;
+        run_queue_insert (&_ctx, current);
+    } else {
+        current->state = HEV_TASK_WAITING;
+    }
+
+    next = run_queue_first (&_ctx);
+    if (next) {
+        _ctx.current_task = next;
+        if (_setjmp (current->context) == 0) {
+            _longjmp (next->context, 1);
+        }
+        _ctx.current_task = current;
+    } else {
+        _ctx.current_task = NULL;
+        if (_setjmp (current->context) == 0) {
+            _longjmp (_ctx.main_context, 1);
+        }
+        _ctx.current_task = current;
+    }
+}
+
+int
+hev_task_system_init (void)
+{
+    memset (&_ctx, 0, sizeof (_ctx));
+
+    _ctx.reactor = hev_task_io_reactor_new ();
+    if (!_ctx.reactor)
+        return -1;
+
+    _ctx.timer = hev_task_timer_new (&_ctx);
+    if (!_ctx.timer) {
+        hev_task_io_reactor_destroy (_ctx.reactor);
+        return -1;
+    }
+
+    _ctx.stack_detector = hev_task_stack_detector_new ();
+
+    return 0;
+}
+
+void
+hev_task_system_run (void)
+{
+    _ctx.running = 1;
+
+    while (_ctx.running) {
+        HevTask *next = run_queue_first (&_ctx);
+
+        if (next) {
+            _ctx.current_task = next;
+            if (_setjmp (_ctx.main_context) == 0) {
+                if (next->state == HEV_TASK_STOPPED)
+                    hev_task_executer (next);
+                _longjmp (next->context, 1);
+            }
+            _ctx.current_task = NULL;
+        } else {
+            HevTaskIOReactorWaitEvent events[MAX_EVENTS];
+            int timeout, n;
+
+            timeout = hev_task_timer_get_timeout (_ctx.timer);
+            n = hev_task_io_reactor_wait (_ctx.reactor, events, MAX_EVENTS,
+                                           timeout);
+
+            for (int i = 0; i < n; i++) {
+                HevTaskSchedEntity *entity;
+                entity = hev_task_io_reactor_wait_event_get_data (&events[i]);
+                if (entity && entity->task)
+                    hev_task_system_wakeup_task (entity->task);
+            }
+
+            hev_task_timer_wake (_ctx.timer);
+        }
+    }
+}
+
+void
+hev_task_system_fini (void)
+{
+    _ctx.running = 0;
+
+    if (_ctx.stack_detector) {
+        hev_task_stack_detector_destroy (_ctx.stack_detector);
+        _ctx.stack_detector = NULL;
+    }
+
+    if (_ctx.dns_proxy) {
+        hev_task_dns_proxy_destroy (_ctx.dns_proxy);
+        _ctx.dns_proxy = NULL;
+    }
+
+    if (_ctx.timer) {
+        hev_task_timer_destroy (_ctx.timer);
+        _ctx.timer = NULL;
+    }
+
+    if (_ctx.reactor) {
+        hev_task_io_reactor_destroy (_ctx.reactor);
+        _ctx.reactor = NULL;
+    }
+}
