diff -ruN iproute2-7.2.0.orig/include/namespace.h iproute2-7.2.0/include/namespace.h
--- iproute2-7.2.0.orig/include/namespace.h	2026-10-11 12:45:15.087765890 +0800
+++ iproute2-7.2.0/include/namespace.h	2026-10-11 12:48:44.256853214 +0800
@@ -39,7 +39,15 @@
 #endif
 
 #ifndef HAVE_SETNS
-static inline int setns(int fd, int nstype)
+
+/*
+ * setns compatibility: musl declares setns() in sched.h.
+ * Only provide fallback when libc does not expose it.
+ */
+
+#if defined(__GLIBC__)
+
+static inline int iproute2_setns(int fd, int nstype)
 {
 #ifdef __NR_setns
 	return syscall(__NR_setns, fd, nstype);
@@ -48,6 +56,25 @@
 	return -1;
 #endif
 }
+
+#define setns iproute2_setns
+
+#elif !defined(__linux__)
+
+static inline int iproute2_setns(int fd, int nstype)
+{
+	errno = ENOSYS;
+	return -1;
+}
+
+#define setns iproute2_setns
+
+#else
+
+/* Linux + musl: use libc setns() from sched.h */
+
+#endif /* libc detection */
+
 #endif /* HAVE_SETNS */
 
 int netns_switch(char *netns);
