+	BN_RET_ON_ERR(ec_point_proj_bin_mult(&tmB, bd, curve));
+	BN_RET_ON_ERR(ec_point_proj_add(&tmA, &tmB, curve));
+	BN_RET_ON_ERR(ec_point_proj_export_affine(&tmA, res, curve));
