+#ifndef HAVE_TIMINGSAFE_BCMP
+static inline int
+timingsafe_bcmp(const void *b1, const void *b2, size_t len) {
+	int ret = 0;
+	const uint8_t *p1 = b1, *p2 = b2;
+
+	if (0 == len || b1 == b2)
+		return (0);
+	if (NULL == b1 ||
+	    NULL == b2)
+		return (1);
+	for (size_t i = 0; i < len; i ++) {
+		ret |= (p1[i] ^ p2[i]);
+	}
+	return ((0 != ret));
+}
+#endif
