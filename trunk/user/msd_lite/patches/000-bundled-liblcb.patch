+	/* Z3 = Z1 * T1 */
+	BN_RET_ON_ERR(bn_mod_mult(&tm1, &a->z, &curve->p, &curve->p_mod_rd_data));
+	BN_RET_ON_ERR(bn_assign(&a->z, &tm1));
+	/* T1 = 2 * T3 */
+	BN_RET_ON_ERR(bn_assign(&tm1, &tm3));
+	BN_RET_ON_ERR(bn_mod_mult_digit(&tm1, 2, &curve->p, &curve->p_mod_rd_data));
