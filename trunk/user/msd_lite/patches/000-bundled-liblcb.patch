+#pragma unroll
+		for (t = 0; t < 80; t ++) {
+			temp1 = H + SHA2_64_SIGMA1(E) + SHA2_Ch(E, F, G) + K[t] + W[t];
+			temp2 = SHA2_64_SIGMA0(A) + SHA2_Maj(A, B, C);
+			H = G;
+			G = F;
+			F = E;
+			E = D + temp1;
+			D = C;
+			C = B;
+			B = A;
+			A = temp1 + temp2;
+		}
