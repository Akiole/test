+// DNS_R_F_*
+#define DNS_R_CD_F_UPDATING	(((uint16_t)1) << 8) /* Update in progress. Prevent cache cleanp delete. */
+#define DNS_R_CD_F_CNAME	(((uint16_t)1) << 9) /* Data is cname - alias name. */
+
+
+
+/* Used for DNS cache dump callback. */
