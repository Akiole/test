+	if (NULL != result_hi)
+		(*result_hi) = res_hi;
+	if (NULL != remainder_lo)
+		(*remainder_lo) = rem_lo;
+	if (NULL != remainder_hi)
+		(*remainder_hi) = rem_hi;
