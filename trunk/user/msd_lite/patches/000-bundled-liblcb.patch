+    memset(r2+m->digits+1, 0x00, (2*MAX_NN_DIGITS+8-m->digits-1)*NN_DIGIT_LEN);
+    if (NN_Cmp(r1, r2, m->digits+1) < 0)
+      r1[m->digits+1] = 1;
