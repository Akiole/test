+static inline uint16_t
+RCodeSplit(uint8_t rcode, uint8_t ex_rcode) {
+	uint16_t rcode16;
+
+	rcode16 = ex_rcode;
+	rcode16 = (uint16_t)(rcode16 << 4);
+	rcode16 |= (rcode & 0x0f);
+
+	return (rcode16);
+}
+
+static inline uint8_t
+RCodeUnSplit(uint16_t rcode16, uint8_t *ex_rcode) {
+
+	if (NULL != ex_rcode) 
+		(*ex_rcode) = (uint8_t)((rcode16 >> 4) & 0xff);
+
+	return ((rcode16 & 0x0f));
+}
