+#define HTTP_CLI_CONN_STATE_REQ_HDRS_SENDED	4
+#define HTTP_CLI_CONN_STATE_REQ_PAYLOAD_SENDING	5
+#define HTTP_CLI_CONN_STATE_REQ_PAYLOAD_SENDED	6
