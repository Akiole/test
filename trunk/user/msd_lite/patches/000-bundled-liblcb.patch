+static inline void
+sha1_memcpy_bswap(uint8_t *dst, const uint8_t *src, size_t size) {
+	register size_t i;
+
+#pragma unroll
+	for (i = 0; i < size; i += 4) {
+		dst[(i + 0)] = src[(i + 3)];
+		dst[(i + 1)] = src[(i + 2)];
+		dst[(i + 2)] = src[(i + 1)];
+		dst[(i + 3)] = src[(i + 0)];
+	}
+}
