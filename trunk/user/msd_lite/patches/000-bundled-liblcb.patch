+	a += b; d = ROTL32((d ^ a), 16);				\
+	c += d; b = ROTL32((b ^ c), 12);				\
+	a += b; d = ROTL32((d ^ a),  8);				\
+	c += d; b = ROTL32((b ^ c),  7);				\
+}
