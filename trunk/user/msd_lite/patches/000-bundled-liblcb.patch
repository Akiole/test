+			    &n1,
+			    &n2);
+			/* Store result to dst. */
+			U32TO8_LITTLE(dst, htonl(n2));
+			U32TO8_LITTLE((dst + sizeof(uint32_t)), htonl(n1));
+			src += GOST28147_BLK_SIZE;
+			dst += GOST28147_BLK_SIZE;
+		}
+	}
+}
