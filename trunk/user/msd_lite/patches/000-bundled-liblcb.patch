+/* Computes: a += b. Returns carry. */
+static inline void
+bn_digits_add_digit(bn_digit_t *a, size_t count, bn_digit_t b, bn_digit_t *carry) {
+	register size_t i;
+	register bn_digit_t crr = 0;
