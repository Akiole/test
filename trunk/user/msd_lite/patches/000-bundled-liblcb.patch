+upnp_ssdp_if_p
+upnp_ssdp_get_if_by_index(upnp_ssdp_p ssdp, uint32_t if_index) {
+	uint32_t i;
+
+	if (NULL == ssdp)
+		return (NULL);
+
+	for (i = 0; i < ssdp->s_ifs_cnt; i ++) {
+		if (ssdp->s_ifs[i]->if_index == if_index)
+			return (ssdp->s_ifs[i]);
+	}
+
+	return (NULL);
+}
