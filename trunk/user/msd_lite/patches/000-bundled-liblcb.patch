+#define MD5_II(a, b, c, d, x, s, ac) do {				\
+	(a) += MD5_I((b), (c), (d)) + (x) + (uint32_t)(ac);		\
+	(a) = MD5_ROTATE_LEFT((a), (s));				\
+	(a) += (b);							\
+} while (0)
