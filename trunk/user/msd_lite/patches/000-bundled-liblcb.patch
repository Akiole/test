+
+typedef struct r_buf_s { /* Ring buf. */
+	uint8_t		*buf;		/* Ring buf. */
+	size_t		size;		/* Ring buf size. */
+	size_t		wpos;		/* Write offset. */
+	uint8_t		*buf_max;	/* Ring buf max pos. */
