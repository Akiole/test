+static inline int
+bn_digit_div(bn_digit_t dividend_lo, bn_digit_t dividend_hi, bn_digit_t divisor,
+    bn_digit_t *result_lo, bn_digit_t *result_hi,
+    bn_digit_t *remainder_lo, bn_digit_t *remainder_hi) {
