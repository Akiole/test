+	((uint32_t*)(dst))[ 3] += ((uint32_t*)(src))[ 3];		\
+	((uint32_t*)(dst))[ 4] += ((uint32_t*)(src))[ 4];		\
+	((uint32_t*)(dst))[ 5] += ((uint32_t*)(src))[ 5];		\
+	((uint32_t*)(dst))[ 6] += ((uint32_t*)(src))[ 6];		\
+	((uint32_t*)(dst))[ 7] += ((uint32_t*)(src))[ 7];		\
