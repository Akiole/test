+#ifndef __MEMORY_UTILS_H__
+#define __MEMORY_UTILS_H__
+
+#include <sys/param.h>
+#include <sys/types.h>
+#include <sys/mman.h> /* mmap, munmap */
+#include <inttypes.h>
+#include <stdlib.h>
