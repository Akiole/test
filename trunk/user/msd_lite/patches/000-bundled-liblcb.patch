+#else
+#define _mm_bswap_epi32(__x) do {					\
+	(__x) = _mm_shufflehi_epi16((__x), _MM_SHUFFLE(2, 3, 0, 1));	\
+	(__x) = _mm_shufflelo_epi16((__x), _MM_SHUFFLE(2, 3, 0, 1));	\
+	(__x) = _mm_or_si128(_mm_slli_epi16((__x), 8), _mm_srli_epi16((__x), 8)); \
