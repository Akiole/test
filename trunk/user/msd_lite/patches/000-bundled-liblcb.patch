+
+/* EBUSY - for sendfile() */
+#define SKT_ERR_FILTER(__error)						\
+    ((EAGAIN == (__error) ||						\
+      EWOULDBLOCK == (__error) ||					\
+      EBUSY == (__error) ||						\
+      EINTR == (__error)) ?						\
+     0 : (__error))
