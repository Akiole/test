+#define UNUM2STR(_num, _type, _buf, _size, _size_ret) do {		\
+	size_t _len;							\
+	if (NULL == (_buf) || 0 == (_size))				\
+		return (EINVAL);					\
+	for (_len = 1;							\
+	     _len < POW10LST_COUNT && ((uint64_t)(_num)) > pow10lst[_len]; \
+	     _len ++)							\
+		;							\
+	if ((_len + 1) > (_size)) {					\
+		if (NULL != (_size_ret)) {				\
+			*(_size_ret) = (_len + 1);			\
+		}							\
+		return (ENOSPC);					\
+	}								\
+	(_buf) += _len;							\
+	(*(_buf)) = 0;							\
+	do {								\
+		(_buf) --;						\
+		(*(_buf)) = (_type)('0' + ((_num) % 10));		\
+		(_num) /= 10;						\
+	} while ((_num));						\
+	if (NULL != (_size_ret)) {					\
+		*(_size_ret) = _len;					\
+	}								\
+	return (0);							\
+} while (0)
+
+#define SNUM2STR(_num, _type, _buf, _size, _size_ret) do {		\
+	size_t _len, _neg = 0;						\
+	if (NULL == (_buf) || 0 == (_size))				\
+		return (EINVAL);					\
+	if (0 > (_num)) {						\
+		(_num) = ((_type)0) - (_num);				\
+		_neg = 1;						\
+	}								\
+	for (_len = 1;							\
+	     _len < POW10LST_COUNT && ((uint64_t)(_num)) > pow10lst[_len]; \
+	     _len ++)							\
+		;							\
+	_len += _neg;							\
+	if ((_len + 1) > (_size)) {					\
+		if (NULL != (_size_ret)) {				\
+			*(_size_ret) = (_len + 1);			\
+		}							\
+		return (ENOSPC);					\
+	}								\
+	if (_neg) {							\
+		(*(_buf)) = '-';					\
+	}								\
+	(_buf) += _len;							\
+	(*(_buf)) = 0;							\
+	do {								\
+		(_buf) --;						\
+		(*(_buf)) = (_type)('0' + ((_num) % 10));		\
+		(_num) /= 10;						\
+	} while ((_num));						\
+	if (NULL != (_size_ret)) {					\
+		*(_size_ret) = _len;					\
+	}								\
+	return (0);							\
+} while (0)
+
