+#define GOST3411_2012_AVX256_LXSLP(__dymm0, __dymm1, __aymm0, __aymm1, __ptr) do { \
+	__m256i symm0, symm1;						\
+									\
+	GOST3411_2012_AVX256_LOAD((__ptr), symm0, symm1);		\
+	GOST3411_2012_AVX256_XOR2_512((__dymm0), (__dymm1),		\
