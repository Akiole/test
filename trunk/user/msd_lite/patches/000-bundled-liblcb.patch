+/* Call this before first other code use. */
+static inline void
+dhcp4_static_init(void) {
+
+	if (NULL == dhcp4_opt55[0]) {
+		for (size_t i = 0; i < nitems(dhcp4_options); i ++) {
+			dhcp4_opt55[i] = dhcp4_options[i].disp_name;
+		}
+	}
+}
