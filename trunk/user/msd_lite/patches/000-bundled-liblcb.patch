+reallocarray(void *ptr, const size_t nmemb, const size_t size) {
+	size_t nmemb_size;
+
+	nmemb_size = (nmemb * size);
+	if (0 == nmemb_size) {
+		if (0 != nmemb &&
+		    0 != size) { /* Overflow. */
+			errno = ENOMEM;
+			return (NULL);
+		}
+		nmemb_size ++;
+	} else if (((nmemb | size) & (SIZE_T_MAX << (sizeof(size_t) * 4))) &&
+	    (nmemb_size / size) != nmemb) { /* size_t overflow. */
+		errno = ENOMEM;
+		return (NULL);
+	}
+
+	return (realloc(ptr, nmemb_size));
+}
