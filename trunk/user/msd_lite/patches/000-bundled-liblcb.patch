+#define HTTP_SRV_AUTH_TYPE_F_UNKNOWN	0 /* none. */
+#define HTTP_SRV_AUTH_TYPE_F_BASIC	(((uint32_t)1) << 1)
+#define HTTP_SRV_AUTH_TYPE_F_DIGEST	(((uint32_t)1) << 2)
