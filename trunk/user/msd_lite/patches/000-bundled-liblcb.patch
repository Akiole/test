+static inline void
+sha2_memcpy_bswap4(uint8_t *dst, const uint8_t *src, const size_t size) {
+	register size_t i;
+
+#pragma unroll
+	//for (i = 0; i < size; i ++)
+	//	dst[i] = src[((i & ~3) + (3 - (i & 0x03)))]; /* bswap()/htonl() */
+	for (i = 0; i < size; i += 4) {
+		dst[(i + 0)] = src[(i + 3)];
+		dst[(i + 1)] = src[(i + 2)];
+		dst[(i + 2)] = src[(i + 1)];
+		dst[(i + 3)] = src[(i + 0)];
+	}
+}
+
+static inline void
+sha2_memcpy_bswap8(uint8_t *dst, const uint8_t *src, const size_t size) {
+	register size_t i;
+
+#pragma unroll
+	//for (i = 0; i < size; i ++)
+	//	dst[i] = src[((i & ~7) + (7 - (i & 0x07)))]; /* bswap()/htonl() */
+	for (i = 0; i < size; i += 8) {
+		dst[(i + 0)] = src[(i + 7)];
+		dst[(i + 1)] = src[(i + 6)];
+		dst[(i + 2)] = src[(i + 5)];
+		dst[(i + 3)] = src[(i + 4)];
+		dst[(i + 4)] = src[(i + 3)];
+		dst[(i + 5)] = src[(i + 2)];
+		dst[(i + 6)] = src[(i + 1)];
+		dst[(i + 7)] = src[(i + 0)];
+	}
+}
