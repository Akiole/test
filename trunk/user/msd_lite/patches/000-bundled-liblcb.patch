+/* a_count - all available digits, b_count - set to non zero digits count. */
+static inline int
+bn_digits_add(bn_digit_t *a, size_t a_count, bn_digit_t *b, size_t b_count,
+    bn_digit_t *carry) {
+	int error = 0;
+	register size_t i;
+	register bn_digit_t tm, crr = 0;
+
+	if (NULL == a || NULL == b) {
+		error = EINVAL;
+		goto ok_exit;
+	}
+	if (0 == b_count)
+		goto ok_exit;
+	if (a_count < b_count) {
+		error = EOVERFLOW;
+		goto ok_exit;
+	}
+	BN_PREFETCH_DIGITS(a, a_count);
+	BN_PREFETCH_DIGITS(b, b_count);
+	for (i = 0; i < b_count; i ++) {
+		tm = b[i]; /* If a == b */
+		a[i] += crr;
+		crr = ((a[i] < crr) ? 1 : 0);
+		if (0 == tm)
+			continue;
+		a[i] += tm;
+		if (a[i] < tm) {
+			crr = 1;
+		}
+	}
+	if (0 != crr && a_count > b_count) {
+		bn_digits_add_digit(&a[b_count], (a_count - b_count), crr, carry);
+		return (0);
+	}
+ok_exit:
+	if (NULL != carry)
+		(*carry) = crr;
+	return (error);
