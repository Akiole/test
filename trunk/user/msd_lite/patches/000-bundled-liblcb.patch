+		A = (hash[0] += A);
+		B = (hash[1] += B);
+		C = (hash[2] += C);
+		D = (hash[3] += D);
+		E = (hash[4] += E);
+		F = (hash[5] += F);
+		G = (hash[6] += G);
+		H = (hash[7] += H);
