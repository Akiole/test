+
+/* Returns: the significant length of a in digits. */
+static inline size_t
+bn_digits_calc_digits(bn_digit_t *a, size_t count) {
+	register ssize_t i;
+
+	if (NULL == a || 0 == count)
+		return (0);
+	for (i = (ssize_t)(count - 1); i >= 0; i --) {
+		if (0 != a[i])
+			break;
+	}
+	return ((size_t)(i + 1));
+}
+
+/* Returns: sign of a - b. */
+/* XXX: timing attack? */
+/* XXX: memcmp() optimization? */
+static inline int
+bn_digits_cmp(bn_digit_t *a, bn_digit_t *b, size_t count) {
+	register ssize_t i;
+
+	if (a == b || 0 == count)
+		return (0); /* Euqual. */
+	if (NULL == a || NULL == b) {
+		if (NULL != a)
+			return (1);
+		return (-1);
+	}
+	for (i = (ssize_t)(count - 1); i >= 0; i --) {
+		if (a[i] == b[i])
+			continue;
+		if (a[i] > b[i])
+			return (1);
+		return (-1);
+	}
+	return (0); /* Euqual. */
+}
