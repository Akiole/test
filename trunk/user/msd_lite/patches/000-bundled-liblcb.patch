+#define GOST3411_2012_AVX256_XSLP(__dymm0, __dymm1, __aymm0, __aymm1,	\
+    __bymm0, __bymm1) do {						\
+	GOST3411_2012_AVX256_XOR2_512((__dymm0), (__dymm1),		\
