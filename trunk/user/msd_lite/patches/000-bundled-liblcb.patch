+static void
+test_sleep(const uint64_t msec) { 
+	struct timespec rqts;
+
+	/* 1 sec = 1000000000 nanoseconds. */
+	rqts.tv_sec = (msec / 1000ul);
+	rqts.tv_nsec = ((msec % 1000ul) * 1000000ul);
+
+	for (; 0 != nanosleep(&rqts, &rqts);) {
+		if (EINTR != errno)
+			break;
+	}
+}
