+#define GOST3411_2012_AVX256_SLP(__dymm0, __dymm1, __ymm0, __ymm1) do {	\
+	GOST3411_2012_ALIGN(32) uint8_t idxarr[64];			\
+									\
+	GOST3411_2012_AVX256_STORE(&idxarr, (__ymm0), (__ymm1));	\
