--- a/lib/getprogname.c	2026-03-18 06:01:45.000000000 +0800
+++ b/lib/getprogname.c	2026-10-10 13:04:51.546973611 +0800
@@ -21,6 +21,12 @@
 
 #include <errno.h> /* get program_invocation_name declaration */
 
+#ifdef __linux__
+# include <fcntl.h>
+# include <unistd.h>
+# include <string.h>
+#endif
+
 #ifdef _AIX
 # include <unistd.h>
 # include <procinfo.h>
@@ -251,6 +257,26 @@
       close (fd);
     }
   return "?";
+# elif defined __linux__
+  static char *p;
+  static int first = 1;
+  if (first)
+    {
+      first = 0;
+      int fd = open ("/proc/self/cmdline", O_RDONLY);
+      if (fd >= 0)
+        {
+          char buf[4096];
+          ssize_t n = read (fd, buf, sizeof (buf) - 1);
+          if (n > 0)
+            {
+              buf[n] = '\0';
+              p = strdup (buf);
+            }
+          close (fd);
+        }
+    }
+  return p ? last_component (p) : "?";
 # else
 #  error "getprogname module not ported to this OS"
 # endif
