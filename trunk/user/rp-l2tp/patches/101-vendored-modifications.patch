-    fd = socket(AF_LOCAL, SOCK_STREAM, 0);
-    if (fd < 0) {
-	perror("socket");
-	return -1;
-    }
-    if (connect(fd, (struct sockaddr *) &addr, SUN_LEN(&addr)) < 0) {
-	perror("connect");
-	close(fd);
-	return -1;
-    }
-    v[0].iov_base = (char *) cmd;
-    v[0].iov_len = strlen(cmd);
-    v[1].iov_base = "\n";
-    v[1].iov_len = 1;
-    writev(fd, v, 2);
-    return fd;
-}
