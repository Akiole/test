require-b2 5.2 ;

constant boost_dependencies :
    /boost/config//boost_config
    /boost/core//boost_core
    ;

project /boost/io ;

explicit
    [ alias boost_io : : : : <include>include <library>$(boost_dependencies) ]
    [ alias all : boost_io test ]
    ;

call-if : boost-library io
    ;
