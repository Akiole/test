### Target Vendor/Product
############################################################

### Target vendor
CONFIG_VENDOR=Ralink

### Target product platform
CONFIG_PRODUCT=MT7621

### Board product ID (max 12 chars)
CONFIG_FIRMWARE_PRODUCT_ID="MI-R3P-PB"

### Linux kernel source directory
CONFIG_LINUXDIR=linux-4.4.x

### Do not compress kernel (use raw binary instead of LZMA)
CONFIG_KERNEL_NO_COMPRESS=y

### Kernel Features
############################################################

### Shortcut Forwarding Engine acceleration
CONFIG_FIRMWARE_INCLUDE_SFE=y

### Dynamic DNS client (inadyn)
CONFIG_FIRMWARE_INCLUDE_INADYN=y

### IPv6 support
CONFIG_FIRMWARE_ENABLE_IPV6=y

### USB support
CONFIG_FIRMWARE_ENABLE_USB=n

### CPU overclocking support
CONFIG_FIRMWARE_INCLUDE_OC=n

### MT7621 CPU freq (0x312=1000MHz 0x362=1100MHz 0x372=1120MHz 0x3B2=1200MHz)
CONFIG_FIRMWARE_MT7621_OC="0x312"

### Filesystems
############################################################

### EXT2 filesystem support ~0.1MB
CONFIG_FIRMWARE_ENABLE_EXT2=n

### EXT3 filesystem support ~0.2MB
CONFIG_FIRMWARE_ENABLE_EXT3=n

### EXT4 filesystem support ~0.4MB
CONFIG_FIRMWARE_ENABLE_EXT4=n

### FAT/FAT32 filesystem support ~0.1MB
CONFIG_FIRMWARE_ENABLE_FAT=n

### exFAT filesystem support ~0.12MB
CONFIG_FIRMWARE_ENABLE_EXFAT=n

### XFS filesystem support ~0.6MB
CONFIG_FIRMWARE_ENABLE_XFS=n

### FUSE (filesystems in userspace) support ~0.1MB
CONFIG_FIRMWARE_ENABLE_FUSE=n

### Swap files/partitions support ~0.05MB
CONFIG_FIRMWARE_ENABLE_SWAP=n

### NTFS-3G FUSE driver (instead of Paragon ufsd) ~0.4MB
CONFIG_FIRMWARE_INCLUDE_NTFS_3G=n

### AVM NTFS driver (instead of ntfs-3g)
CONFIG_FIRMWARE_INCLUDE_ANTFS=n

### USB Modules
############################################################

### USB UVC camera modules ~0.2MB
CONFIG_FIRMWARE_INCLUDE_UVC=n

### USB-HID modules ~0.2MB
CONFIG_FIRMWARE_INCLUDE_HID=n

### USB-Serial modules (e.g. pl2303) ~0.03MB
CONFIG_FIRMWARE_INCLUDE_SERIAL=n

### USB-Audio modules ~0.46MB
CONFIG_FIRMWARE_INCLUDE_AUDIO=n

### Network Modules
############################################################

### XFRM (IPsec) modules & iptables extension ~0.2MB
CONFIG_FIRMWARE_INCLUDE_XFRM=n

### Network QoS scheduling modules ~0.2MB
CONFIG_FIRMWARE_INCLUDE_QOS=n

### IMQ module for shapers ~0.02MB
CONFIG_FIRMWARE_INCLUDE_IMQ=n

### IFB module for shapers ~0.03MB
CONFIG_FIRMWARE_INCLUDE_IFB=n

### IPSet utility and kernel modules ~0.4MB
CONFIG_FIRMWARE_INCLUDE_IPSET=y

### CIFS (SMB) client ~0.2MB
CONFIG_FIRMWARE_INCLUDE_CIFS=n

### NFSv3 server ~0.6MB
CONFIG_FIRMWARE_INCLUDE_NFSD=n

### NFSv3 client ~0.5MB
CONFIG_FIRMWARE_INCLUDE_NFSC=n

### WebUI Localization
############################################################

### Chinese language pack
CONFIG_FIRMWARE_INCLUDE_LANG_CN=y

### SSH & Security
############################################################

### Dropbear SSH server ~0.3MB
CONFIG_FIRMWARE_INCLUDE_DROPBEAR=y

### Dropbear faster ciphers/hashes ~0.06MB
CONFIG_FIRMWARE_INCLUDE_DROPBEAR_FAST_CODE=n

### OpenSSH instead of dropbear ~1.0MB
CONFIG_FIRMWARE_INCLUDE_OPENSSH=n

### sftp-server ~0.06MB
CONFIG_FIRMWARE_INCLUDE_SFTP=n

### HTTPS support (requires openssl) ~1.2MB
CONFIG_FIRMWARE_INCLUDE_HTTPS=n

### Elliptic Curves (EC) in openssl ~0.1MB
CONFIG_FIRMWARE_INCLUDE_OPENSSL_EC=y

### openssl executable for cert generation ~0.4MB
CONFIG_FIRMWARE_INCLUDE_OPENSSL_EXE=n

### wpa_supplicant (WPA/WPA2 with nl80211) ~0.2MB
CONFIG_FIRMWARE_INCLUDE_WPA_SUPPLICANT=y

### EAP-TTLS and EAP-PEAP auth support ~1.2MB
CONFIG_FIRMWARE_INCLUDE_EAP_PEAP=n

### File Sharing & Storage
############################################################

### SMB3.6 (and WINS) server ~1.5MB
CONFIG_FIRMWARE_INCLUDE_SMBD=n

### WINS server only ~0.4MB
CONFIG_FIRMWARE_INCLUDE_WINS=n

### syslog for SMB and WINS server ~0.3MB
CONFIG_FIRMWARE_INCLUDE_SMBD_SYSLOG=n

### FTP server (vsftpd) ~0.2MB
CONFIG_FIRMWARE_INCLUDE_FTPD=n

### hdparm utility (HDD spindown/APM) ~0.1MB
CONFIG_FIRMWARE_INCLUDE_HDPARM=n

### parted utility (GPT partitions) ~0.3MB
CONFIG_FIRMWARE_INCLUDE_PARTED=n

### LPR printer daemon ~0.12MB
CONFIG_FIRMWARE_INCLUDE_LPRD=n

### USB-over-Ethernet printer daemon ~0.05MB
CONFIG_FIRMWARE_INCLUDE_U2EC=n

### VPN
############################################################

### OpenVPN (IPv6 required) ~0.4MB
CONFIG_FIRMWARE_INCLUDE_OPENVPN=n

### StrongSwan IPsec ~0.7MB
CONFIG_FIRMWARE_INCLUDE_SSWAN=n

### SoftEther VPN server
CONFIG_FIRMWARE_INCLUDE_SOFTETHERVPN_SERVER=n

### SoftEther VPN client
CONFIG_FIRMWARE_INCLUDE_SOFTETHERVPN_CLIENT=n

### SoftEther VPN command-line tool
CONFIG_FIRMWARE_INCLUDE_SOFTETHERVPN_CMD=n

### WireGuard VPN ~10KB
CONFIG_FIRMWARE_INCLUDE_WIREGUARD=n

### RP-L2TP alternative L2TP control client ~0.1MB
CONFIG_FIRMWARE_INCLUDE_RPL2TP=n

### xTun VPN tunnel
CONFIG_FIRMWARE_INCLUDE_xTUN=n


### Proxy & Anti-censorship
############################################################

### Shadowsocks proxy
CONFIG_FIRMWARE_INCLUDE_SHADOWSOCKS=y

### Shadowsocks server
CONFIG_FIRMWARE_INCLUDE_SSSERVER=n

### Xray proxy core ~4.5MB
CONFIG_FIRMWARE_INCLUDE_XRAY=y

### V2Ray proxy core
CONFIG_FIRMWARE_INCLUDE_V2RAY=n

### Trojan proxy ~1.2MB
CONFIG_FIRMWARE_INCLUDE_TROJAN=n

### Wing proxy tool
CONFIG_FIRMWARE_INCLUDE_WING=n

### simple-obfs obfuscation plugin
CONFIG_FIRMWARE_INCLUDE_SSOBFS=n

### sing-box proxy core
CONFIG_FIRMWARE_INCLUDE_SINGBOX=n

### NaiveProxy proxy
CONFIG_FIRMWARE_INCLUDE_NAIVEPROXY=n

### FRP intranet penetration client
CONFIG_FIRMWARE_INCLUDE_FRPC=n

### FRP intranet penetration server
CONFIG_FIRMWARE_INCLUDE_FRPS=n

### redsocks transparent proxy
CONFIG_FIRMWARE_INCLUDE_REDSOCKS=n

### MicroSocks lightweight SOCKS5 proxy
CONFIG_FIRMWARE_INCLUDE_MICROSOCKS=n

### 3proxy proxy server
CONFIG_FIRMWARE_INCLUDE_3PROXY=n

### Adbyby ad blocker Plus+
CONFIG_FIRMWARE_INCLUDE_ADBYBY=n

### DNS & Network Tools
############################################################

### dns-forwarder DNS forwarder
CONFIG_FIRMWARE_INCLUDE_DNSFORWARDER=n

### SmartDNS DNS server
CONFIG_FIRMWARE_INCLUDE_SMARTDNS=n

### AdGuard Home ad blocker
CONFIG_FIRMWARE_INCLUDE_ADGUARDHOME=n

### Aliyun DDNS
CONFIG_FIRMWARE_INCLUDE_ALIDDNS=n

### ddnsto intranet penetration ~0.5MB
CONFIG_FIRMWARE_INCLUDE_DDNSTO=n

### Aliyun Drive WebDAV ~3MB
CONFIG_FIRMWARE_INCLUDE_ALDRIVER=n

### SQM QoS traffic management
CONFIG_FIRMWARE_INCLUDE_SQM=n

### srelay SOCKS proxy
CONFIG_FIRMWARE_INCLUDE_SRELAY=n

### ZeroTier virtual LAN ~1.3MB
CONFIG_FIRMWARE_INCLUDE_ZEROTIER=n

### natmap port mapping ~0.1MB
CONFIG_FIRMWARE_INCLUDE_NATMAP=n

### n2n virtual LAN ~0.3MB
CONFIG_FIRMWARE_INCLUDE_N2N=n

### rtp2httpd RTP to HTTP ~0.1MB
CONFIG_FIRMWARE_INCLUDE_RTP2HTTPD=n

### fakehttp fake HTTP service ~0.5MB
CONFIG_FIRMWARE_INCLUDE_FAKEHTTP=n

### fakesip fake SIP service ~0.3MB
CONFIG_FIRMWARE_INCLUDE_FAKESIP=n

### webd web server ~0.1MB
CONFIG_FIRMWARE_INCLUDE_WEBD=n

### curl command-line tool
CONFIG_FIRMWARE_INCLUDE_CURL=y

### Media & Download
############################################################

### xUPNPd IPTV media server ~0.3MB
CONFIG_FIRMWARE_INCLUDE_XUPNPD=n

### MiniDLNA UPnP media server ~1.6MB
CONFIG_FIRMWARE_INCLUDE_MINIDLNA=n

### Firefly iTunes media server ~1.0MB
CONFIG_FIRMWARE_INCLUDE_FIREFLY=n

### ffmpeg 0.11.x (for MiniDLNA/Firefly) ~0.1MB
CONFIG_FIRMWARE_INCLUDE_FFMPEG_NEW=n

### Transmission BitTorrent client ~1.5MB
CONFIG_FIRMWARE_INCLUDE_TRANSMISSION=n

### Transmission Web Control advanced UI ~0.8MB
CONFIG_FIRMWARE_INCLUDE_TRANSMISSION_WEB_CONTROL=n

### Aria2 download manager ~3.5MB
CONFIG_FIRMWARE_INCLUDE_ARIA=n

### Aria2 Web control UI ~0.7MB
CONFIG_FIRMWARE_INCLUDE_ARIA_WEB_CONTROL=n

### System Utilities
############################################################

### tcpdump packet capture ~0.6MB
CONFIG_FIRMWARE_INCLUDE_TCPDUMP=n

### htop process monitor
CONFIG_FIRMWARE_INCLUDE_HTOP=n

### nano text editor
CONFIG_FIRMWARE_INCLUDE_NANO=n

### iperf3 network bandwidth test
CONFIG_FIRMWARE_INCLUDE_IPERF3=n

### mtr network diagnostic
CONFIG_FIRMWARE_INCLUDE_MTR=n

### socat network utility
CONFIG_FIRMWARE_INCLUDE_SOCAT=n

### lrzsz file transfer
CONFIG_FIRMWARE_INCLUDE_LRZSZ=n

### ttyd web terminal
CONFIG_FIRMWARE_INCLUDE_TTYD=n

### vlmcsd KMS activation server
CONFIG_FIRMWARE_INCLUDE_VLMCSD=y

### msd_lite (replaces udpxy)
CONFIG_FIRMWARE_INCLUDE_MSD_LITE=y

### dump1090 ADS-B receiver
CONFIG_FIRMWARE_INCLUDE_DUMP1090=n

### RTL-SDR software defined radio
CONFIG_FIRMWARE_INCLUDE_RTL_SDR=n

### tmux terminal multiplexer ~0.3MB
CONFIG_FIRMWARE_INCLUDE_TMUX=n

### neofetch system info ~0.4MB
CONFIG_FIRMWARE_INCLUDE_NEOFETCH=n

### jq JSON processor ~0.5MB
CONFIG_FIRMWARE_INCLUDE_JQ=n

### Campus Network Authentication
############################################################

### MentoHUST Ruijie authentication
CONFIG_FIRMWARE_INCLUDE_MENTOHUST=n

### MiniEAP campus network authentication
CONFIG_FIRMWARE_INCLUDE_MINIEAP=n

### ScutClient SCUT authentication
CONFIG_FIRMWARE_INCLUDE_SCUTCLIENT=n

### GDUT-DrCOM GDUT authentication
CONFIG_FIRMWARE_INCLUDE_GDUT_DRCOM=n

### dogcom DrCOM authentication
CONFIG_FIRMWARE_INCLUDE_DOGCOM=n

### NJIT-Client NJIT authentication
CONFIG_FIRMWARE_INCLUDE_NJIT_CLIENT=n
